NEXT_PUBLIC_APP_NAME=Angkor Commerce
# Stage 1 back-office-portal talks to DummyJSON directly, not core-api.
NEXT_PUBLIC_API_BASE_URL=https://dummyjson.com

# back-office-portal server-side AI insights feature
AI_API_KEY=
AI_MODEL=gemini-3.5-flash

# Host ports for the two Next.js apps (change if already taken on your machine)
BACK_OFFICE_HOST_PORT=3000
CUSTOMER_PORTAL_HOST_PORT=3001

SERVER_PORT=8080
POSTGRES_DB=acme_invoice
POSTGRES_USER=acme
POSTGRES_PASSWORD=change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/acme_invoice
SPRING_DATASOURCE_USERNAME=acme
SPRING_DATASOURCE_PASSWORD=change_me
CORS_ALLOWED_ORIGINS=http://localhost:3000


# MinIO root credentials (admin/console only — never given to the app)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=demopass

# Scoped credentials minio-init provisions for core-api at startup (bucket-only access, not root)
MINIO_APP_ACCESS_KEY=angkor-app
MINIO_APP_SECRET_KEY=change_me_app_secret

# MinIO bucket used by the app
MINIO_BUCKET=angkor-commerce-media

# Host ports (change if 9000/9001 are already taken on your machine)
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# jsreport — Studio login, and the credentials core-api renders with
JSREPORT_USER=admin
JSREPORT_PASSWORD=change_me_jsreport
JSREPORT_COOKIE_SECRET=change_me_jsreport_cookie
# Loopback host port for Studio (dev only, via docker-compose.override.yml)
JSREPORT_HOST_PORT=5480
